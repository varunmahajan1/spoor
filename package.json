{
  "name": "spoor-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "ranges:update": "node scripts/update-ranges.mjs",
    "test:php": "bash scripts/test-php.sh",
    "golden": "node scripts/generate-golden.mjs",
    "test:all": "npm run build && npm test && npm run test:php"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/varunmahajan1/spoor.git"
  },
  "author": "Varun Mahajan",
  "license": "MIT"
}
