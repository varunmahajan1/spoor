{
  "name": "@spoor/sinks",
  "version": "0.1.0",
  "description": "Pluggable destinations for spoor events. File, webhook and memory; no cloud SDK dependencies.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@spoor/core": "0.1.0"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/varunmahajan1/spoor.git",
    "directory": "packages/sinks"
  },
  "homepage": "https://github.com/varunmahajan1/spoor#readme",
  "bugs": {
    "url": "https://github.com/varunmahajan1/spoor/issues"
  },
